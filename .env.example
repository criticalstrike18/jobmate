# Firebase Web App Credentials for JobMate
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app SDK setup

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Google One Tap (pill "Continue as ..." top-right)
# This is the OAuth 2.0 Web Client ID from Google Cloud Console ->
# APIs & Services -> Credentials (same project as Firebase).
# Also add your origin (http://localhost:5173 + production domain) to
# Authorized JavaScript origins for that Client ID, or One Tap won't show.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
